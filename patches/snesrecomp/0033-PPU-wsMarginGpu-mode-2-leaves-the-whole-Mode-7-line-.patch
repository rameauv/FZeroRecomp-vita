From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: valentin rameau <valentin.rameau@outlook.fr>
Date: Tue, 29 Sep 2026 06:22:52 +0900
Subject: [PATCH 33/33] PPU: wsMarginGpu mode 2 leaves the whole Mode 7 line to
 the host GPU, and PpuColorWindowSpans

Mode 2 skips BG1 and the compose loop for the whole line; sprites are still
drawn into bgBuffers[0]. PpuColorWindowSpans exports the colour window span
list the compose loop uses. Inert when the flag is clear: FBCRC and FLATCRC
unchanged over 2,999 frames.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runner/src/snes/ppu.c | 30 +++++++++++++++++++++++++++---
 runner/src/snes/ppu.h | 27 +++++++++++++++++++--------
 2 files changed, 46 insertions(+), 11 deletions(-)

diff --git a/runner/src/snes/ppu.c b/runner/src/snes/ppu.c
index ee832ac..f7552a4 100644
--- a/runner/src/snes/ppu.c
+++ b/runner/src/snes/ppu.c
@@ -343,8 +343,8 @@ void PpuSetMode7MarginTiles(Ppu *ppu, const uint8_t *tiles) {
   ppu->m7MarginTiles = tiles;
 }
 
-void PpuSetWidescreenMarginGpu(Ppu *ppu, bool on) {
-  ppu->wsMarginGpu = on ? 1 : 0;
+void PpuSetWidescreenMarginGpu(Ppu *ppu, int mode) {
+  ppu->wsMarginGpu = (uint8_t)mode;
 }
 
 void PpuSetWidescreenCentreSkip(Ppu *ppu, bool skip) {
@@ -2153,7 +2153,8 @@ static void PpuDrawBackground_mode7(Ppu *ppu, PpuPixelPrioBufs *dstbuf, uint y,
           do dstz[i] = pixel + z; while (++i != w);
         }
       } while (xpos += dx * w, ypos += dy * w, dstz += w, w = PPU_mosaicSize(ppu), dstz_end - dstz != 0);
-    } else if (m7margin && (x2 <= 0 || x >= kPpuXPixels) && ppu->wsMarginGpu) {
+    } else if (ppu->wsMarginGpu == 2 ||
+               (m7margin && (x2 <= 0 || x >= kPpuXPixels) && ppu->wsMarginGpu)) {
       continue;  // the host's GPU draws this span (Ppu::wsMarginGpu)
     } else if (m7margin && (x2 <= 0 || x >= kPpuXPixels)) {
       /* A margin span. The tile number comes from the host's per-column array
@@ -2468,6 +2469,27 @@ int PpuMarginColorWindow(Ppu *ppu, int y) {
   return result;
 }
 
+int PpuColorWindowSpans(Ppu *ppu, int y, int16_t *edges, uint8_t *keep,
+                        uint8_t *math) {
+  uint8 hud_height = ppu->wsHudSplitHeight & 0x7f;
+  if ((hud_height && y < hud_height && ppu->extraLeftRight) ||
+      ((ppu->wsHudSplitHeight & 0x80) && ppu->wsHudOamHeight) ||
+      PpuFullBudgetAnchorLayerAt(ppu, y) >= 0 ||
+      PpuWidescreenLineRepeatBandActive(ppu, y))
+    return -1;
+  PpuWindows cwin;
+  PpuWindows_Calc(&cwin, ppu, 5, y);
+  static const uint8 kCwBitsMod[8] = {
+    0x00, 0xff, 0xff, 0x00,
+    0xff, 0x00, 0xff, 0x00,
+  };
+  *keep = (uint8)((cwin.bits & kCwBitsMod[PPU_clipMode(ppu)]) ^ kCwBitsMod[PPU_clipMode(ppu) + 4]);
+  *math = (uint8)((cwin.bits & kCwBitsMod[PPU_preventMathMode(ppu)]) ^ kCwBitsMod[PPU_preventMathMode(ppu) + 4]);
+  for (uint i = 0; i <= cwin.nr; i++)
+    edges[i] = cwin.edges[i];
+  return cwin.nr;
+}
+
 static NOINLINE void PpuDrawWholeLine(Ppu *ppu, uint y) {
   PpuClearOverlayRenderLine(ppu, y);
   if (PPU_forcedBlank(ppu)) {
@@ -2565,6 +2587,8 @@ static NOINLINE void PpuDrawWholeLine(Ppu *ppu, uint y) {
   uint32 windex = 0;
   do {
     uint32 left = cwin.edges[windex] + kPpuExtraLeftRight, right = cwin.edges[windex + 1] + kPpuExtraLeftRight;
+    if (ppu->wsMarginGpu == 2)
+      continue;  // the host's GPU composes the whole line
     if (ppu->wsMarginGpu) {
       /* Keep only the part of the span inside the authentic 256 columns. The
        * spans are contiguous from left_first, so dst is set from left rather
diff --git a/runner/src/snes/ppu.h b/runner/src/snes/ppu.h
index e49c408..e943ec6 100644
--- a/runner/src/snes/ppu.h
+++ b/runner/src/snes/ppu.h
@@ -352,12 +352,13 @@ struct Ppu {
    * PpuWidescreenCentreSkipSafe for the per-line conditions that make the
    * remaining margins byte-identical. */
   uint8_t wsCentreSkip;
-  /* Leave the MARGINS to the host's GPU (strategy D). With this set and
-   * m7MarginTiles bound, Mode 7 BG1 is not drawn
-   * outside [0,256) and the compose loop does not write the margins of
-   * renderBuffer. Sprites still are, so after the line bgBuffers[0] holds, in
-   * the margins, the backdrop or the winning OBJ pixel with its z. The host
-   * composes BG1, OBJ and colour math from that. */
+  /* Leave part of a Mode 7 line to the host's GPU (strategy D).
+   * 1: with m7MarginTiles bound, Mode 7 BG1 is not
+   * drawn outside [0,256) and the compose loop does not write the margins of
+   * renderBuffer. 2: the same for the WHOLE line, so renderBuffer's row is
+   * not written at all. Sprites are still drawn, so after the line
+   * bgBuffers[0] holds the backdrop or the winning OBJ pixel with its z where
+   * BG1 was left out. The host composes BG1, OBJ and colour math from that. */
   uint8_t wsMarginGpu;
   uint32_t overlayRenderPitch[kPpuOverlaySource_Count];
   uint8_t *overlayRenderBuffer[kPpuOverlaySource_Count];
@@ -701,8 +702,18 @@ void PpuSetMode7MarginTiles(Ppu *ppu, const uint8_t *tiles);
 extern int g_ppu_line_write_src;
 extern unsigned long g_ppu_line_writes[4][0x40];
 
-// See Ppu::wsMarginGpu. Set it per scanline, with m7MarginTiles bound.
-void PpuSetWidescreenMarginGpu(Ppu *ppu, bool on);
+// See Ppu::wsMarginGpu: 0 off, 1 margins, 2 whole line. Set it per
+// scanline, with m7MarginTiles bound.
+void PpuSetWidescreenMarginGpu(Ppu *ppu, int mode);
+
+// The colour window on scanline `y` as the compose loop uses it: nr spans,
+// span i covering screen x in [edges[i], edges[i+1]). keep bit i set means
+// span i keeps the main colour (not clipped to black); math bit i set means
+// colour math may apply there. Returns nr, or -1 when the line composes in a
+// widescreen HUD or repeat mode, which this does not model. edges holds up
+// to 8 entries.
+int PpuColorWindowSpans(Ppu *ppu, int y, int16_t *edges, uint8_t *keep,
+                        uint8_t *math);
 
 // The colour window at the margins on scanline `y`, as the compose loop would
 // use it for x = -1 (bits 0..1) and x = 256 (bits 2..3). Per side, bit 0 set
