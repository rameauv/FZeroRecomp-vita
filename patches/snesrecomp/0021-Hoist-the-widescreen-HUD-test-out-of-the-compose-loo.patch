+/* Same, for the sprite range-evaluation early-out. Also defined for every
+ * host so PC can prove it pixel-exact. */
+int g_ppu_fast_sprite_eval = 1;
+
 #ifdef SNESRECOMP_INTERP_PROFILE
 static double g_ppu_sec_eval_ms = 0;
 static double g_ppu_sec_line_ms = 0;
@@ -2345,6 +2352,16 @@ static NOINLINE void PpuDrawWholeLine(Ppu *ppu, uint y) {
   uint32 windex = 0;
   do {
     uint32 left = cwin.edges[windex] + kPpuExtraLeftRight, right = cwin.edges[windex + 1] + kPpuExtraLeftRight;
+    /* The per-pixel widescreen-HUD blanking test depends only on i and on
+     * booleans already fixed for this scanline. If no full-width HUD is
+     * active AND this span lies entirely inside the world, it can never
+     * blank a pixel, so it is decided once here instead of per pixel --
+     * removing two range checks and, in the no-math loop, a nibble extract
