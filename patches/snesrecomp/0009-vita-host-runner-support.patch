+/* ---- APU worker (second core) ----------------------------------------
+ *
+ * Off by default; the host opts in before the first RtlRunFrame. When on, the
+ * game thread stops advancing the SPC and instead publishes ONE target per
+ * frame -- the guest cycle at the end of the frame it just completed -- and a
+ * worker thread walks the SPC up to that ceiling on another core while the
+ * game thread runs the next frame.
+ *
+ * Determinism is preserved because the worker is paced by GUEST cycles, never
+ * wall-clock: the ceiling is a frame boundary, every queued port write is
+ * stamped with a guest cycle, and writes issued during frame N+1 necessarily
+ * carry stamps at or beyond that ceiling. Which APU cycle each event lands on
+ * is therefore independent of how far the worker happens to have got, exactly
+ * as it is independent of when the single-threaded build chose to flush.
+ * See HANDOFF.md section 10. */
+void RtlApuWorkerEnable(int on);
+int  rtl_apu_worker_active(void);
+/* Worker body, one bounded slice. Takes RtlApuLock, advances the SPC by at
+ * most max_cycles SPC cycles toward the published ceiling, releases it.
+ * Returns 1 while work remains (call again), 0 when the ceiling is reached.
+ * Slicing is what keeps the lock hold short enough that a game-thread port
+ * write or an audio callback does not wait behind a whole frame of SPC work;
+ * it does not affect which APU cycle anything lands on. */
+int  rtl_apu_worker_slice(uint32_t max_cycles);
+/* Worker instrumentation, read by the host's per-frame log. */
+void rtl_apu_worker_stats(uint64_t *slices, uint64_t *idle, uint64_t *late);
+/* Output-side starvation, counted rather than inferred: episodes and the
+ * output frames faded to silence. The only direct evidence that the DSP ring
+ * is deep enough with the APU running a frame behind. */
+extern uint64_t g_rtl_audio_starve_episodes, g_rtl_audio_starve_frames;
+
