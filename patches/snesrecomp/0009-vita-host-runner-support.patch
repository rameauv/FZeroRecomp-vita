+/* ======================================================================
+ * APU worker (second core). See the contract in common_rtl.h and
+ * HANDOFF.md section 10.
+ *
+ * Every variable below, and g_rtl_apu_worker declared further up, is read and
+ * written ONLY under RtlApuLock. That is deliberate on a 32-bit weakly-ordered
+ * core: g_apu_worker_target is
+ * uint64_t, so an unlocked load is two 32-bit accesses and can tear, and the
+ * lock supplies the release/acquire pair that makes the queued port writes
+ * published before it visible to the other core. The cost is one acquisition
+ * per side per frame plus one per worker slice.
+ * ====================================================================== */
+static uint64_t g_apu_worker_target = 0;/* guest-cycle ceiling, frame ends only */
+static int      g_apu_worker_busy = 0;  /* ceiling not yet reached */
+static uint64_t g_apu_worker_slices = 0;/* slices executed                    */
+static uint64_t g_apu_worker_idle = 0;  /* polls that found the ceiling reached */
+static uint64_t g_apu_worker_late = 0;  /* publishes that found it still behind */
+
+void RtlApuWorkerEnable(int on) {
+  RtlApuLock();
+  g_rtl_apu_worker = on ? 1 : 0;
+  RtlApuUnlock();
+}
+
+int rtl_apu_worker_active(void) { return g_rtl_apu_worker; }
+
+int rtl_apu_worker_slice(uint32_t max_cycles) {
+  RtlApuLock();
+  if (!g_apu_worker_busy) {
+    g_apu_worker_idle++;
+    RtlApuUnlock();
+    return 0;
+  }
+  audio_trace_set_producer(AUDIO_TRACE_PRODUCER_CPU);
+  uint64_t before = g_snes->apu->portClock;
+  /* max_cycles exhausted => returns false with the ceiling unchanged, so
+   * re-entering resumes exactly where this slice stopped. No APU-side state
+   * is needed to make the advance resumable. */
+  bool reached = apu_runToGuestCycle(g_snes->apu, g_apu_worker_target,
+                                     max_cycles);
+  audio_trace_on_guest_sync(1, g_snes->apu->portClock - before);
+  audio_trace_set_producer(AUDIO_TRACE_PRODUCER_UNKNOWN);
+  g_apu_worker_slices++;
+  if (reached) g_apu_worker_busy = 0;
+  RtlApuUnlock();
+  return reached ? 0 : 1;
+}
+
+void rtl_apu_worker_stats(uint64_t *slices, uint64_t *idle, uint64_t *late) {
+  RtlApuLock();
+  if (slices) *slices = g_apu_worker_slices;
+  if (idle)   *idle   = g_apu_worker_idle;
+  if (late)   *late   = g_apu_worker_late;
+  RtlApuUnlock();
+}
+
+/* Hand the worker the frame just completed. Caller: game thread, once per
+ * frame, holding RtlApuLock. If the previous ceiling has not been reached the
+ * worker is behind real time -- that is the health metric to watch, not a
+ * correctness problem:
+ * raising the ceiling while it is still walking toward the old one is the
+ * same monotone sequence of targets, just later in host time. */
+static void rtl_apu_worker_publish_locked(uint64_t boundary) {
+  if (g_apu_worker_busy) g_apu_worker_late++;
+  if (boundary > g_apu_worker_target) g_apu_worker_target = boundary;
+  g_apu_worker_busy = 1;
+}
