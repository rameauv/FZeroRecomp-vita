diff --git a/runner/src/snes/interp_bridge.c b/runner/src/snes/interp_bridge.c
index d646737..ebdaf4e 100644
--- a/runner/src/snes/interp_bridge.c
+++ b/runner/src/snes/interp_bridge.c
@@ -856,6 +856,39 @@ static void itrace_dump(uint32_t entry, const ITraceEnt *head, int nhead,
     }
 }
 
+/* ── Always-on global interp step ring ─────────────────────────────────
+ * The per-run head[]/ring[] above are stack locals — invisible to a
+ * post-mortem or halt fired mid-run. This ring records EVERY interpreted
+ * step (pc, op, sp, frame) continuously so a late observer can read the
+ * interpreter's recent control flow backward (ring-buffer doctrine: no
+ * arm-then-capture). 8192 entries ≈ several frames of pure-interp code.
+ *
+ * Read it with interp_bridge_recent_step() below. There is deliberately no
+ * stderr dump here: upstream retired the g_interp_recent_dump_hook halt path
+ * in favour of the function-local ring, and the host that needs this one
+ * (the Vita port) has no usable stderr and logs over the network instead. */
+#define ITRACE_RECENT_LEN 8192
+typedef struct { uint32_t pc; int32_t frame; uint16_t sp; uint8_t op; uint8_t pad; } ITraceRecentEnt;
+static ITraceRecentEnt g_itrace_recent[ITRACE_RECENT_LEN];
+static uint64_t g_itrace_recent_n = 0;
+
+/* Programmatic read of the recent-step ring, for hosts with no usable stderr
+ * (the Vita port logs over the network). `back` is 1-based and counts
+ * backwards from the newest step. Returns 0 when `back` is out of range. */
+int interp_bridge_recent_step(int back, uint32_t *pc, uint8_t *op,
+                              uint16_t *sp, int32_t *frame) {
+    uint64_t have = g_itrace_recent_n < ITRACE_RECENT_LEN
+                        ? g_itrace_recent_n : ITRACE_RECENT_LEN;
+    if (back < 1 || (uint64_t)back > have) return 0;
+    const ITraceRecentEnt *e =
+        &g_itrace_recent[(g_itrace_recent_n - (uint64_t)back) & (ITRACE_RECENT_LEN - 1)];
+    if (pc) *pc = e->pc;
+    if (op) *op = e->op;
+    if (sp) *sp = e->sp;
+    if (frame) *frame = e->frame;
+    return 1;
+}
+
 /* Tier-2 coverage table (definitions below, § gap manifest): shared by the
  * tier-down entries AND the in-bridge gap recorders in the core loop. */
 enum { TIER2_KIND_DISPATCH = 0, TIER2_KIND_INDIRECT_GOTO = 1,
@@ -1787,6 +1820,34 @@ static int _interp_run_core(CpuState *cpu, uint32_t entry_pc24,
             if (itn < 8) head[itn] = _e;
             if (trace) ring[itn & 255] = _e;
             itn++;
+            extern int snes_frame_counter;
+            ITraceRecentEnt *_g =
+                &g_itrace_recent[g_itrace_recent_n++ & (ITRACE_RECENT_LEN - 1)];
+            _g->pc = pc_before; _g->frame = snes_frame_counter;
+            _g->sp = in.sp; _g->op = op; _g->pad = 0;
+#ifdef VITA
+            /* Off-rails entry capture. A wedge in unmapped space runs far
+             * longer than the 8192-entry ring, so by bail time the ring holds
+             * only the wedge loop and the transition is long gone. Latch the
+             * crossing itself: the last mapped-bank step, and the first
+             * unmapped one. Cleared per frame by the host. */
+            { extern void interp_bridge_note_offrails_vita(uint32_t prev_pc,
+                                                           uint8_t prev_op,
+                                                           uint16_t prev_sp,
+                                                           uint32_t pc,
+                                                           uint8_t op);
+              static uint32_t s_prev_pc; static uint8_t s_prev_op;
+              static uint16_t s_prev_sp; static int s_prev_mapped;
+              uint8_t _bank = (uint8_t)(pc_before >> 16);
+              int _mapped = (_bank <= 0x07) || (_bank >= 0x80 && _bank <= 0x87) ||
+                            _bank == 0x7E || _bank == 0x7F;
+              if (s_prev_mapped && !_mapped)
+                interp_bridge_note_offrails_vita(s_prev_pc, s_prev_op, s_prev_sp,
+                                                 pc_before, op);
+              s_prev_pc = pc_before; s_prev_op = op; s_prev_sp = in.sp;
+              s_prev_mapped = _mapped;
+            }
+#endif
         }
         /* Env-gated diagnostic (SNESRECOMP_C2WATCH=1): log every interpreted
          * opcode in the menu-blit range $C2:FC40-$C2:FF00 with the live mode
@@ -1851,10 +1912,10 @@ static int _interp_run_core(CpuState *cpu, uint32_t entry_pc24,
                         "op=$%02X frame=%d sp=$%04X — corrupted control transfer\n",
                         _pbnk, (unsigned)pc_before, op, snes_frame_counter,
                         (unsigned)in.sp);
