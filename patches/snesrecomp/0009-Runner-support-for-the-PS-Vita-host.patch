diff --git a/runner/src/vita_getenv.c b/runner/src/vita_getenv.c
new file mode 100644
index 0000000..99f6550
--- /dev/null
+++ b/runner/src/vita_getenv.c
@@ -0,0 +1,57 @@
+/*
+ * vita_getenv.c - Vita-specific getenv wrapper
+ *
+ * On PS Vita, the standard getenv() has a bug that returns 0x812a0000
+ * (a pointer to the .init_array section) instead of NULL for non-existent
+ * environment variables. This causes crashes when the code tries to
+ * dereference the pointer.
+ *
+ * Since Vita doesn't have a real environment like desktop systems,
+ * we wrap the standard getenv() and return NULL for all variables,
+ * disabling debug features on Vita.
+ */
+
+#include <string.h>
+
+/* Forward declaration of the real getenv function */
+extern char *__real_getenv(const char *name);
+
+/* Wrapper for getenv that returns NULL for all variables on Vita.
+ * This disables all debug/diagnostic features that rely on environment
+ * variables, which is appropriate for Vita where there's no real environment.
+ */
+char *__wrap_getenv(const char *name) {
+  /* Special case: SDL_VIDEODRIVER might be checked by SDL2 */
+  if (name && strcmp(name, "SDL_VIDEODRIVER") == 0) {
+    return NULL;  /* Let SDL2 use its default */
+  }
+  
+  /* Special case: SDL_AUDIODRIVER */
+  if (name && strcmp(name, "SDL_AUDIODRIVER") == 0) {
+    return NULL;  /* Let SDL2 use its default */
+  }
+  
+  /* All other environment variables: return NULL to disable features.
+   * This covers all SNESRECOMP_* and SNES_* variables used for
+   * debugging, cosimulation, netplay, etc. - features not needed
+   * in a standard Vita build. */
+  return NULL;
+}
+
+/* Provide a weak alias as well for additional safety */
+/* Note: __attribute__((alias)) is not supported on Darwin/macOS, so we use a
+   function definition there instead. On Vita, the linker will handle the alias. */
+#if defined(__APPLE__) || defined(__MACH__) || defined(__Darwin__)
+/* On macOS/Darwin, aliases are not supported, so provide a function definition */
+char *getenv(const char *name) {
+  return __wrap_getenv(name);
+}
+#elif defined(__vita__) || defined(VITA)
+/* On Vita (real hardware), use weak alias - the Vita linker supports this */
+__attribute__((weak, alias("__wrap_getenv"))) 
+char *getenv(const char *name);
+#else
+/* For other platforms, use weak alias if supported */
+__attribute__((weak, alias("__wrap_getenv"))) 
+char *getenv(const char *name);
+#endif
