/* A whole Mode 7 ground line, composed on the GPU, all 398 columns. The
 * centre's BG1 reads the real tilemap, the margins' the host's side array, and the colour
 * window is a per-line span list, because in the centre it is not uniform.
 * The CPU draws only the sprites of such a line (Ppu::wsMarginGpu = 2).
 *
 * The render target is 398 x 224 (row stride 400), screen x -71..326. The
 * output is the final colour, R G B A in memory, and the present scene draws
 * it in place of the CPU's frame.
 *
 * Inputs, all integer queries. The per-line layout is FZeroGroundGpuPack in
 * src/fzero_ground_gpu.h, and FZeroGroundGpuModel there is this shader in C:
 *   lines  16 x 224, U16 x4, per line (see fzero_ground_gpu.h)
 *   mtiles 144 x 224, U8: the margins' tile per column (side array)
 *   vram   128 x 128, U8 x2: the VRAM words; x = the tilemap byte,
 *          y = the character data byte
 *   objz   398 x 224, U16: the PPU's z-buffer after drawing OBJ over the
 *          backdrop, with BG1 left out
 *   cgram  256 x 1, U8 x4: CGRAM split into (r, g, b, 0)
 *   flat   398 x 224: the CPU's frame, taken as is on a line the host kept
 *   course 256 x 256, U8: the 64 KB course map, byte i at (i mod 256, i / 256).
 *          On a line with t3.w set the margins' tile is looked up here
 *          (FZeroGroundTile: room, row, panel, tile) instead of in mtiles.
 *          The coordinates are 21-bit (11 + 10 bits) so
 *          that u modulo 8192 is exact (tools/mode7_exact.c part 6).
 *
 * Exactness: every value is an integer below 2^21 and every division is by a
 * power of two; the 18-bit coordinates travel as 11 + 7 bits
 * (tools/mode7_exact.c part 5, 13.4 G cases, 0 bad). Brightness is
 * floor((x + 0.5) / 15), exact (part 4). */

float Bit(float v, float weight)
{
    float q = floor(v / weight);
    return q - 2.0f * floor(q * 0.5f);
}

float3 Bright(float3 v, float brightness)
{
    v = min(v, float3(31.0f, 31.0f, 31.0f));
    float3 e = v * 8.0f + floor(v * 0.25f);
    return floor((e * brightness + 0.5f) * (1.0f / 15.0f));
}

float Byte(usampler2D course, float i)
{
    float y = floor(i * (1.0f / 256.0f));
    /* Rounded: on device the fetch returns slightly less than some integers
     * (180 as 179.99...), and the lookups use it in more address arithmetic. */
    return floor(tex2D<unsigned char>(course, float2((i - 256.0f * y + 0.5f) * (1.0f / 256.0f),
                                                     (y + 0.5f) * (1.0f / 256.0f))) + 0.5f);
}

/* v modulo m, m a power of two passed with its reciprocal. Not v / m: the
 * GPU divides through an approximate reciprocal, and the result lands just
 * below the integer. A multiply by an
 * exact power-of-two reciprocal is exact. */
float Mod(float v, float m, float inv_m)
{
    return v - m * floor(v * inv_m);
}

float4 OneHot(float i)
{
    return float4(i == 0.0f ? 1.0f : 0.0f, i == 1.0f ? 1.0f : 0.0f,
                  i == 2.0f ? 1.0f : 0.0f, i == 3.0f ? 1.0f : 0.0f);
}

void main(float4 wpos : WPOS,
          uniform usampler2D lines,
          uniform usampler2D mtiles,
          uniform usampler2D vram,
          uniform usampler2D objz,
          uniform usampler2D cgram,
          uniform usampler2D flat,
          uniform usampler2D course,
          out __regformat unsigned char4 result : COLOR0)
{
    float col = floor(wpos.x);
    float line = floor(wpos.y);
    float ty = (line + 0.5f) * (1.0f / 224.0f);
    float tx = (col + 0.5f) * (1.0f / 398.0f);
    float x = col - 71.0f;
    float4 cpu = tex2D<unsigned char4>(flat, float2(tx, ty));
    float4 t0 = tex2D<unsigned short4>(lines, float2(0.5f / 16.0f, ty));
    float4 t1 = tex2D<unsigned short4>(lines, float2(1.5f / 16.0f, ty));
    float4 t2 = tex2D<unsigned short4>(lines, float2(2.5f / 16.0f, ty));
    float4 t3 = tex2D<unsigned short4>(lines, float2(3.5f / 16.0f, ty));
    float4 t4 = tex2D<unsigned short4>(lines, float2(4.5f / 16.0f, ty));
    float4 t5 = tex2D<unsigned short4>(lines, float2(5.5f / 16.0f, ty));
    float4 t6 = tex2D<unsigned short4>(lines, float2(6.5f / 16.0f, ty));
    float4 t7 = tex2D<unsigned short4>(lines, float2(7.5f / 16.0f, ty));

    /* BG1 coordinates: A = lo_b + lo_k * x, T = hi_b + floor(A/2048) + hi_k * x. */
    float2 A = float2(t0.x + t0.z * x, t1.x + t1.z * x);
    float2 q = floor(A * (1.0f / 2048.0f));
    float2 fine = floor((A - 2048.0f * q) * (1.0f / 256.0f));
    float2 T = float2(t0.y, t1.y) + q + float2(t0.w, t1.w) * x;
    float2 cell = T - 128.0f * floor(T * (1.0f / 128.0f));

    bool margin = x < 0.0f || x >= 256.0f;
    float mcol = x < 0.0f ? col : (x >= 256.0f ? col - 256.0f : 0.0f);
    float mt;
    if (margin && t3.w != 0.0f) {
        /* The course lookup. U and V are u and v modulo 8192 and 4096 plus
         * the course origin (t8); T modulo 1024 is bits 11..20 of the sum. */
        float4 t8 = tex2D<unsigned short4>(lines, float2(8.5f / 16.0f, ty));
        float2 U = (T - 1024.0f * floor(T * (1.0f / 1024.0f))) * 8.0f + fine;
        float X = Mod(U.x + t8.y, 8192.0f, (1.0f / 8192.0f));
        float Y = Mod(U.y + t8.z, 4096.0f, (1.0f / 4096.0f));
        float fx8 = floor(X * (1.0f / 256.0f)), fy8 = floor(Y * (1.0f / 256.0f));
        float room = Byte(course, t8.x + fy8 * 32.0f + fx8);
        float ra = 20480.0f + room * 32.0f + Mod(floor(Y * (1.0f / 16.0f)), 16.0f, (1.0f / 16.0f)) * 2.0f;
        float rowp = Byte(course, ra) + 256.0f * Byte(course, ra + 1.0f);
        float entry = Mod(rowp + Mod(floor(X * (1.0f / 16.0f)), 16.0f, (1.0f / 16.0f)) * 2.0f, 65536.0f, (1.0f / 65536.0f));
        float panel = Byte(course, entry) + 256.0f * Byte(course, Mod(entry + 1.0f, 65536.0f, (1.0f / 65536.0f)));
        mt = Byte(course, Mod(panel + Mod(floor(X * 0.125f), 2.0f, 0.5f) * 2.0f +
                              Mod(floor(Y * 0.125f), 2.0f, 0.5f), 65536.0f, (1.0f / 65536.0f)));
    } else {
        mt = tex2D<unsigned char>(mtiles, float2((mcol + 0.5f) * (1.0f / 144.0f), ty));
    }
    float map = tex2D<unsigned char2>(vram, (cell + 0.5f) * (1.0f / 128.0f)).x;
    float tile = margin ? mt : map;
    float idx = tile * 64.0f + fine.y * 8.0f + fine.x;
    float iy = floor(idx * (1.0f / 128.0f));
    float bg = tex2D<unsigned char2>(vram, float2((idx - 128.0f * iy + 0.5f) * (1.0f / 128.0f),
                                                  (iy + 0.5f) * (1.0f / 128.0f))).y;

    /* Priority. BG1's level is 5: OBJ priority 1..3 is above it, OBJ
     * priority 0 and the backdrop only show where BG1 is transparent. */
    float z = tex2D<unsigned short>(objz, float2(tx, ty));
    float level = floor(z * (1.0f / 4096.0f));
    float zhi = floor(z * (1.0f / 256.0f));
    bool use_bg = level <= 5.0f && bg != 0.0f;
    float index = use_bg ? bg : z - 256.0f * zhi;
    float layer = use_bg ? 0.0f : zhi - 16.0f * level;

    /* The colour window span, then its flags. */
    float xb = x + 128.0f;
    float span = (xb >= t4.x ? 1.0f : 0.0f) + (xb >= t4.y ? 1.0f : 0.0f) +
                 (xb >= t4.z ? 1.0f : 0.0f) + (xb >= t4.w ? 1.0f : 0.0f) +
                 (xb >= t5.x ? 1.0f : 0.0f) + (xb >= t5.y ? 1.0f : 0.0f) +
                 (xb >= t5.z ? 1.0f : 0.0f);
    float flags = span < 4.0f ? dot(t6, OneHot(span)) : dot(t7, OneHot(span - 4.0f));

    float3 rgb = tex2D<unsigned char4>(cgram, float2((index + 0.5f) * (1.0f / 256.0f), 0.5f)).xyz;
    rgb *= Bit(flags, 1.0f);
    float math = layer == 0.0f ? Bit(flags, 2.0f) : layer == 4.0f ? Bit(flags, 4.0f)
               : layer == 5.0f ? Bit(flags, 8.0f) : 0.0f;
    float3 sum = t3.z != 0.0f ? max(rgb - t2.xyz, float3(0.0f, 0.0f, 0.0f)) : rgb + t2.xyz;
    sum = t3.y != 0.0f ? floor(sum * 0.5f) : sum;
    rgb = math != 0.0f ? sum : rgb;

    float3 out_rgb = Bright(rgb, t2.w);
    result = t3.x != 0.0f ? unsigned char4(out_rgb.x, out_rgb.y, out_rgb.z, 0) : cpu;
}
