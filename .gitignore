.DS_Store
__pycache__/
.pytest_cache/

# Local build output.
/build*/

# Recompiled ROM code. It is a derivative of F-Zero (USA).sfc and must never be
# published. Regenerate it locally with tools/regenerate.sh.
/generated/

# Ghidra project (a disassembly of the ROM, so also a derivative) and the
# session lock it writes beside it.
/fzero-recomp.rep/
/fzero-recomp.gpr
/fzero-recomp.lock
/fzero-recomp.lock~

# Vita crash dumps. These are snapshots of live game memory, so they carry ROM
# content as well as being pure runtime noise.
/*.psp2dmp
/*.psp2dmp.decompressed
/psp2core-*

# Local helper binaries and unrelated checkouts that happen to live in this
# directory.
/vita-crashdump*
/sm64-vita/
/FZeroRecomp-pc/
/samples/
/sdkDoc
/debugnet/

# Editor and agent scratch.
/.cursor/
/log.txt
/docs/log.txt

# Local launcher state (normally written beside the executable).
/config.ini
/config.ini.tmp
/keybinds.ini
/rom.cfg

# Private inputs and runtime evidence. Never publish these.
/reference/
/saves/
/captures/
/screenshots/
/evidence/
/recordings/
/replays/
/traces/
/workspaces/
/project.txt
/*.sfc
/*.smc
/*.fig
/*.srm
/*.srm.bak
/*.state
/*.jsonl
*.sqlite
*.sqlite-*
*.mmo
tier2_*.json

# Windows dependency caches.
/.tools/
/vcpkg_installed/

# Vita3K emulator loop (.claude/skills/vita3k-run): a second build tree and the
# log it copies back. Both are artifacts of a run, not source.
build-vita3k/
vita3k-log.txt
.claude/
